*.jsonl
*.ndjson
*.parquet
*.avro
*.orc
*.feather
*.arrow
*.hdf5
*.h5
*.pkl
*.pickle
*.npz
*.npy
*.db
*.sqlite
*.sqlite3
data/raw/
data/processed/
data/curated/
data/output/

# ── Compressed archives ───────────────────────────────────────
*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.bz2
*.7z
*.rar

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
.venv/
venv/
env/
ENV/
.env/
pip-log.txt
pip-delete-this-directory.txt
