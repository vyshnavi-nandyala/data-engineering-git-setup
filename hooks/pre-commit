#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════
#  Pre-commit hook for Data Engineering projects
#  Install: cp hooks/pre-commit ~/.git-hooks/pre-commit && chmod +x ~/.git-hooks/pre-commit
# ═══════════════════════════════════════════════════════════════

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'

ERRORS=0
WARNINGS=0

pass() { echo -e "  ${GREEN}✔${RESET}  $1"; }
warn() { echo -e "  ${YELLOW}⚠${RESET}  $1"; WARNINGS=$((WARNINGS+1)); }
fail() { echo -e "  ${RED}✖${RESET}  $1"; ERRORS=$((ERRORS+1)); }
info() { echo -e "  ${CYAN}ℹ${RESET}  $1"; }

echo -e "\n${BOLD}${CYAN}═══ Pre-commit checks ════════════════════════════════${RESET}"

# ── 1. Prevent direct commits to main / master ────────────────
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")
echo -e "\n${BOLD}[1/5] Branch protection${RESET}"
if [[ "$BRANCH" == "main" || "$BRANCH" == "master" ]]; then
    fail "Direct commits to '$BRANCH' are not allowed."
    echo -e "       ${YELLOW}Create a feature branch:${RESET} git checkout -b feat/your-feature"
    ERRORS=$((ERRORS+1))
else
    pass "On branch: $BRANCH"
fi

# ── 2. Check for secrets / credentials ────────────────────────
echo -e "\n${BOLD}[2/5] Secret detection${RESET}"
SECRET_PATTERNS=(
    'AWS_SECRET_ACCESS_KEY\s*=\s*[A-Za-z0-9/+=]{40}'
    'aws_secret_access_key\s*=\s*[A-Za-z0-9/+=]{40}'
    'AKIA[0-9A-Z]{16}'
    'password\s*=\s*["\x27][^"\x27]{8,}'
    'private_key.*BEGIN'
    'ghp_[0-9a-zA-Z]{36}'
    'glpat-[0-9a-zA-Z]{20}'
    'token\s*=\s*["\x27][a-zA-Z0-9_\-]{20,}'
)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)
SECRET_FOUND=0
for pattern in "${SECRET_PATTERNS[@]}"; do
    if echo "$STAGED_FILES" | xargs -I{} git show ":{}" 2>/dev/null | grep -qiE "$pattern" 2>/dev/null; then
        SECRET_FOUND=1
    fi
done
# Simpler grep approach
if git diff --cached | grep -qiE '(AWS_SECRET|AKIA[0-9A-Z]{16}|password\s*=\s*["\x27]|ghp_[0-9a-zA-Z]{36})' 2>/dev/null; then
    fail "Potential secret detected in staged changes!"
    echo -e "       ${YELLOW}Remove the secret and use environment variables instead.${RESET}"
else
    pass "No secrets detected"
fi

# ── 3. Check for large files (>5MB) ───────────────────────────
echo -e "\n${BOLD}[3/5] Large file check (>5MB)${RESET}"
LARGE_FILE_FOUND=0
while IFS= read -r file; do
    [[ -z "$file" ]] && continue
    if [[ -f "$file" ]]; then
        SIZE=$(stat -f%z "$file" 2>/dev/null || stat -c%s "$file" 2>/dev/null || echo 0)
        if [[ "$SIZE" -gt 5242880 ]]; then
            fail "Large file: $file ($(( SIZE / 1024 / 1024 ))MB) — add to .gitignore instead"
            LARGE_FILE_FOUND=1
        fi
    fi
done <<< "$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null)"

DATA_EXTENSIONS="csv|tsv|parquet|avro|orc|hdf5|h5|pkl|pickle|jsonl|ndjson|db|sqlite|npz|npy"
while IFS= read -r file; do
    [[ -z "$file" ]] && continue
    if echo "$file" | grep -qiE "\\.($DATA_EXTENSIONS)$"; then
        warn "Data file staged: $file — consider .gitignore or git-lfs"
        LARGE_FILE_FOUND=1
    fi
done <<< "$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null)"

[[ "$LARGE_FILE_FOUND" -eq 0 ]] && pass "No large or data files detected"

# ── 4. Python syntax check ────────────────────────────────────
echo -e "\n${BOLD}[4/5] Python syntax validation${RESET}"
PY_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep '\.py$' || true)
PY_ERRORS=0
if [[ -z "$PY_FILES" ]]; then
    info "No Python files staged"
else
    while IFS= read -r file; do
        [[ -z "$file" ]] && continue
        if ! python3 -m py_compile "$file" 2>/dev/null; then
            fail "Syntax error: $file"
            PY_ERRORS=1
        fi
    done <<< "$PY_FILES"
    [[ "$PY_ERRORS" -eq 0 ]] && pass "Python syntax valid ($(echo "$PY_FILES" | wc -l | tr -d ' ') files)"
fi

# ── 5. Commit message format ──────────────────────────────────
echo -e "\n${BOLD}[5/5] Commit message format${RESET}"
COMMIT_MSG_FILE="${GIT_DIR:-$(git rev-parse --git-dir)}/COMMIT_EDITMSG"
if [[ -f "$COMMIT_MSG_FILE" ]]; then
    MSG=$(head -1 "$COMMIT_MSG_FILE")
    VALID_TYPES="feat|fix|refactor|perf|docs|test|chore|data|schema|revert"
    VALID_SCOPES="data-ingestion|transformation|pipeline|quality|deployment|monitoring|infrastructure|dbt|airflow|glue|redshift|s3|deps"
    if echo "$MSG" | grep -qE "^($VALID_TYPES)(\(($VALID_SCOPES)\))?: .{1,72}$"; then
        pass "Commit message format valid: \"$MSG\""
    elif echo "$MSG" | grep -qE "^#"; then
        info "Skipping format check (comment-only message)"
    else
        warn "Commit message doesn't follow convention"
        echo -e "       Expected: ${CYAN}<type>(<scope>): <subject>${RESET}"
        echo -e "       Example:  ${CYAN}feat(data-ingestion): add parquet support${RESET}"
        echo -e "       Got:      \"$MSG\""
    fi
else
    info "No commit message file found (amend/merge?)"
fi

# ── Summary ───────────────────────────────────────────────────
echo -e "\n${BOLD}${CYAN}═══ Summary ══════════════════════════════════════════${RESET}"
echo -e "  Errors:   ${RED}${ERRORS}${RESET}"
echo -e "  Warnings: ${YELLOW}${WARNINGS}${RESET}"

if [[ "$ERRORS" -gt 0 ]]; then
    echo -e "\n${RED}${BOLD}✖ Commit blocked — fix the errors above.${RESET}"
    echo -e "  To skip hooks (not recommended): ${YELLOW}git commit --no-verify${RESET}\n"
    exit 1
elif [[ "$WARNINGS" -gt 0 ]]; then
    echo -e "\n${YELLOW}${BOLD}⚠ Commit allowed with warnings.${RESET}\n"
    exit 0
else
    echo -e "\n${GREEN}${BOLD}✔ All checks passed — committing!${RESET}\n"
    exit 0
fi
